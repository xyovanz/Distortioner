DISTORTIONER_BOT_TOKEN=YOUR_BOT_TOKEN
DISTORTIONER_ADMIN_ID=YOUR_TELEGRAM_ID
DISTORTIONER_CODEC=libx264

# Optional: leave failed temp files on disk for debugging (default: delete)
# DISTORTIONER_KEEP_FAILED=1

# /update (admin) — git pull + docker build + recreate container
DISTORTIONER_UPDATE_BRANCH=wip
DISTORTIONER_IMAGE=distortioner:local
DISTORTIONER_CONTAINER_NAME=distortioner
DISTORTIONER_ENV_FILE=distortioner.env
DISTORTIONER_DATA_DIR=/path/to/database/directory
