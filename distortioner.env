DISTORTIONER_BOT_TOKEN=YOUR_BOT_TOKEN
DISTORTIONER_ADMIN_ID=YOUR_TELEGRAM_ID
DISTORTIONER_CODEC=libx264

# Optional: leave failed temp files on disk for debugging (default: delete)
# DISTORTIONER_KEEP_FAILED=1

# /update (admin) — git pull + docker build + recreate container
DISTORTIONER_UPDATE_BRANCH=master
DISTORTIONER_IMAGE=distortioner:local
DISTORTIONER_CONTAINER_NAME=distortioner
DISTORTIONER_ENV_FILE=distortioner.env
# Host path for docker -v HOST:/app/data (NOT the in-container path unless the host dir is literally /app/data)
DISTORTIONER_DATA_DIR=/path/to/database/directory
# Absolute path to update.sh inside the container after mounting the repo
# DISTORTIONER_UPDATE_SCRIPT=/home/you/Distortioner/update.sh
DISTORTIONER_UPDATE_LOG=data/update.log
# Optional: used if the checkout has no origin remote
# DISTORTIONER_GIT_REMOTE=https://github.com/xyovanz/Distortioner.git
# GITHUB_TOKEN=
